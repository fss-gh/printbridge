<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.printbridge.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/PrintBridge.app/Contents/MacOS/PrintBridge</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/printbridge.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/printbridge.err.log</string>
</dict>
</plist>
