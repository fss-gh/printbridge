{
  "port": 9120,
  "cors_origins": [
    "http://localhost:*",
    "http://127.0.0.1:*"
  ],
  "log_dir": "~/.printbridge",
  "label_defaults": {
    "width_mm": 100,
    "height_mm": 150,
    "dpmm": 8,
    "gap_mm": 2
  },
  "footer_text": "PrintBridge",
  "tray_name": "PrintBridge",
  "language": "zh",
  "tcp2ws": {
    "enabled": true,
    "host": "0.0.0.0",
    "tcp_port": 9090,
    "ws_port": 8181,
    "max_tcp_clients": 100,
    "close_tcp_when_ws_down": true,
    "close_tcp_on_print_end": false,
    "f1_start_cooldown_seconds": 0,
    "request_expire_seconds": 30,
    "win_title": "激光打标软件",
    "remote_agent_enabled": true,
    "remote_agent_host": "0.0.0.0",
    "remote_agent_port": 9999,
    "remote_markers": [
      {
        "ip": "192.168.0.251",
        "port": 9999
      }
    ],
    "tcp_command_prefix": "TCP:",
    "tcp_commands": [
      "TCP:sampleCode",
      "TCP:sampleCode1",
      "TCP:sampleCode2",
      "TCP:customerCode",
      "TCP:sampleName",
      "TCP:sampleName1",
      "TCP:sampleName2",
      "TCP:companyName",
      "TCP:nextTestDate",
      "TCP:QRCodeContent"
    ],
    "esc_hotkey_interval_seconds": 8,
    "ws_response_timeout": 5,
    "ws_max_retries": 2,
    "tcp_read_timeout": 30,
    "tcp_read_buffer": 4096
  }
}
